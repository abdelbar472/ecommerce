        {
          "name": "Admin Login",
          "description": "Logs in as the seeded admin and stores the JWT in `access_token`, so every other request in this collection (Admin Service, Analytics, ...) runs with admin rights. Account: admin@example.com / admin123.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Role is admin', function () {",
                  "    pm.expect(body.role).to.eql('admin');",
                  "});",
                  "if (body && body.access_token) {",
                  "    pm.collectionVariables.set('access_token', body.access_token);",
                  "    console.log('Saved admin access_token for', body.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
