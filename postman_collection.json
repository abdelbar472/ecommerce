    {
      "name": "Auth Service",
      "description": "Register (cx or seller) and login. Admin accounts cannot self-register — use the seeded admin@example.com / admin123, or create one with Admin Service > Create User.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_url}}/health",
              "host": ["{{auth_url}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Register CX (customer)",
          "description": "Self-signup as a customer (`role = client`). Re-run with a different email if it already exists.",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{client_email}}\",\n    \"password\": \"{{client_password}}\",\n    \"full_name\": \"Cora Customer\",\n    \"role\": \"client\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{auth_url}}/auth/register",
              "host": ["{{auth_url}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
